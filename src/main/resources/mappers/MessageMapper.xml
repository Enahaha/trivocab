<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.trivocab.ielts.mapper.MessageMapper">

    <resultMap id="messageRowMap" type="com.trivocab.ielts.domain.MessageRow">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="adminReply" column="admin_reply"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="messageRowMap">
        SELECT id, user_id, content, status, admin_reply, created_at, updated_at
        FROM messages
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="findByIdAndUserId" resultMap="messageRowMap">
        SELECT id, user_id, content, status, admin_reply, created_at, updated_at
        FROM messages
        WHERE id = #{messageId}
          AND user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.trivocab.ielts.domain.MessageRow"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO messages (user_id, content, status)
        VALUES (#{userId}, #{content}, 'NEW')
    </insert>
</mapper>
